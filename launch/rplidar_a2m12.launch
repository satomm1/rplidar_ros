<launch>

  <arg name="scan_topic" default="scan"/>
  <!-- Scan header stamp: legacy (original) | sweep_start | sweep_mid (see src/node.cpp) -->
  <arg name="stamp_mode" default="legacy"/>

  <node name="rplidarNode"          pkg="rplidar_ros"  type="rplidarNode" output="screen">
  <param name="serial_port"         type="string" value="/dev/ttyUSB0"/>
  <param name="serial_baudrate"     type="int"    value="256000"/>
  <param name="frame_id"            type="string" value="laser_frame"/>
  <param name="inverted"            type="bool"   value="false"/>
  <param name="angle_compensate"    type="bool"   value="true"/>
  <param name="scan_topic"         type="string" value="$(arg scan_topic)"/>
  <param name="stamp_mode"         type="string" value="$(arg stamp_mode)"/>
  </node>
</launch>
